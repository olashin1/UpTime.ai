# Copy to backend/.env. Every key below is read by app/config.py; all are optional
# except DEFAULT_REPO_FULL_NAME (or send repo_full_name in the webhook payload).

# SQLite only (database.py uses SQLite PRAGMA statements).
DATABASE_URL=sqlite:///./app.db

# Repository the agents investigate and load context from.
DEFAULT_REPO_FULL_NAME=owner/repo
DEFAULT_BRANCH=main

# GitHub personal access token (read-only contents access is enough).
# Without it, repository context is empty.
GITHUB_TOKEN=

# Sentry webhook signing secret. If unset, webhook signatures are NOT verified.
SENTRY_WEBHOOK_SECRET=
# Optional: report this backend's own errors to Sentry.
SENTRY_DSN=

# Optional override; defaults to the address derived from the investigation agent's seed.
INVESTIGATION_AGENT_ADDRESS=

# Patch agent LLM (ASI:One, OpenAI-compatible). Without a key, template fallbacks are used.
ASI_ONE_API_KEY=
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
ASI_ONE_MODEL=asi1

# Severity + escalation assessor run by the investigation agent: rules | llm | llm_repo.
# llm_repo also reads the files named in the stack trace from GitHub.
SEVERITY_ASSESSOR=llm_repo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Directory inside the repo that stack-trace paths are relative to (blank = repo root).
REPO_SOURCE_ROOT=
